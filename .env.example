# Copy this file to .env for local overrides. These values are development-only
# defaults, not production credentials.
ENVIRONMENT=development
DEBUG=false

# Conductor overrides this with a unique port for each local workspace.
CONDUCTOR_PORT=8000

POSTGRES_USER=snapstream
POSTGRES_PASSWORD=snapstream
POSTGRES_DB=snapstream
# Keep this in sync if you change the three Postgres values above.
DATABASE_URL=postgresql+asyncpg://snapstream:snapstream@postgres:5432/snapstream
REDIS_URL=redis://redis:6379/0
SESSION_TTL_SECONDS=2592000
FEED_CACHE_TTL_SECONDS=15
MAX_UPLOAD_BYTES=10485760

# S3 is disabled when S3_BUCKET is empty. For the optional LocalStack profile,
# uncomment COMPOSE_PROFILES and use the local development values below.
# COMPOSE_PROFILES=localstack
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
# Optional browser-facing endpoint used only to sign direct uploads locally.
S3_PRESIGN_ENDPOINT_URL=
S3_OBJECT_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# scripts/compose.sh defaults this to CONDUCTOR_PORT + 1 inside Conductor.
# LOCALSTACK_HOST_PORT=4566
